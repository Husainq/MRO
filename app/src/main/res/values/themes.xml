<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MRO" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MRO" parent="Base.Theme.MRO" />

    <style name="Circular">
        <item name="cornerSize">100%</item>
    </style>

    <style name="primary">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="secondary">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="divider2dp">
        <item name="dividerColor">@color/divider</item>
        <item name="dividerThickness">2dp</item>
    </style>

    <style name="divider4dp">
        <item name="dividerColor">@color/divider</item>
        <item name="dividerThickness">6dp</item>
    </style>

</resources>